{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Craft Status",
  "version": "0.1.0",
  "identifier": "ai.storyteller.craft-status",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Craft Status",
        "width": 1340,
        "height": 560,
        "minWidth": 520,
        "minHeight": 240,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Status of the storytold craft repositories",
    "longDescription": "A tray dashboard for the craft repositories: downloads, builds and activity, the most urgent fixes, and a PR review workspace that grades every open PR.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
